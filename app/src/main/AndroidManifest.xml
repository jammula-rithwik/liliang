<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- R20: spoken set notes. The microphone is asked for the first time the
         note seal is pressed, never at launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+ hides other apps' services unless declared: without this
         the phone's speech recogniser is invisible and every note falls back
         to typing. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- ⚖ #60 (2026-08-30): the workouts DB stays OUT of Android cloud backup
         and device transfer — a silent restore of a stale DB would corrupt the
         single source of training truth. The auto-export river IS the backup. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Liliang">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Liliang.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
